# Copy to /etc/homenas/homenas.env only after a target-NAS review.
HOMENAS_HOST=127.0.0.1
HOMENAS_PORT=8787
HOMENAS_RUNTIME_DIR=/var/lib/homenas
HOMENAS_ADMIN_PASSWORD=replace-with-a-long-local-admin-password

# Read-only probes only. Enable after auditing the local endpoints on the target NAS.
HOMENAS_ENABLE_EXTERNAL_PROBES=0

# Keep the long-lived perf/RAPL reader enabled on Linux. It reports Unavailable
# when perf permissions are not granted; it never changes perf_event_paranoid.
HOMENAS_ENABLE_PERF_RAPL=1

# Server-side only; never put the Mihomo secret in frontend code or query strings.
# HOMENAS_MIHOMO_CONTROLLER=http://127.0.0.1:9090
# HOMENAS_MIHOMO_SECRET=change-me
# HOMENAS_SEAFILE_HEALTH_URL=http://127.0.0.1/health

# When enabled, HomeNAS reads Mihomo /version, /configs, /rules and /proxies
# and runs no controller write endpoint. The browser receives sanitized summaries only.

